# Generated by `mise run jinja:Containerfile`. Edit this file, not ./Containerfile.
FROM docker.io/library/node:26.8.2-trixie AS build

COPY --chown=1000:1000 ./site /site

USER 1000:1000
WORKDIR /site

{% if mode == "production" %}
RUN npm ci && \
    npm run astro -- telemetry disable && \
    npm run build

FROM docker.io/library/nginx:1.30.4-trixie
COPY --from=build /site/dist /usr/share/nginx/html
COPY ./nginx/absolute-redirect-off.conf /etc/nginx/conf.d/absolute-redirect-off.conf
COPY ./nginx/real-ip.conf /etc/nginx/conf.d/real-ip.conf
COPY ./nginx/hardening.conf /etc/nginx/conf.d/hardening.conf
EXPOSE 80
{% else %}
RUN npm install && \
    npm run astro -- telemetry disable

ENTRYPOINT []
EXPOSE 4321
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
{% endif %}
