---
import ThemePicker from "./ThemePicker.astro";

const { pathname } = Astro.url;
// href carries a trailing slash (e.g. "/resume/"); pathname doesn't always -
// trailingSlash is "ignore" in astro.config.mjs, so a request for the
// bare "/resume" (as happens in dev, where there's no nginx in front to
// redirect it) reports pathname "/resume" with nothing appended.
const isActive = (href: string) =>
  href === "/"
    ? pathname === "/"
    : (pathname.endsWith("/") ? pathname : `${pathname}/`).startsWith(href);

const links = [
  { href: "/", label: "Home" },
  { href: "/resume/", label: "Résumé" },
  { href: "/tech-stack/", label: "Tech Stack" },
  { href: "/blog/", label: "Blog" },
];
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="brand" href="/">
      <span class="brand__mark" aria-hidden="true">◣</span>
      <span class="brand__text">Salish Sea Wolf</span>
    </a>

    <nav class="site-nav" aria-label="Primary">
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={["site-nav__link", { "is-active": isActive(link.href) }]}
            aria-current={isActive(link.href) ? "page" : undefined}
          >
            {link.label}
          </a>
        ))
      }
      <a
        class="site-nav__link"
        href="https://github.com/salishseawolf"
        rel="me noopener"
        target="_blank">GitHub</a
      >
      <ThemePicker />
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid var(--border);
  }

  /*
   * The frosted-glass fill lives on a pseudo-element rather than directly on
   * .site-header. `backdrop-filter` (like `transform`/`filter`) makes the
   * element it's set on a containing block for `position: fixed`
   * descendants - and ThemePicker's mobile bottom-sheet panel is exactly
   * that, nested inside this header. Left on .site-header itself, the sheet
   * pins to the ~4rem header box instead of the viewport, rendering almost
   * entirely off-screen above it. Putting the filter on ::before instead
   * keeps the visual effect without trapping anything.
   */
  .site-header::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(10px);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6ch;
    font-weight: 650;
    letter-spacing: -0.01em;
    color: var(--text);
  }

  .brand:hover {
    color: var(--text);
    text-decoration: none;
  }

  .brand__mark {
    color: var(--heading);
    font-size: 1.1em;
    transition: transform 0.2s ease;
  }

  .brand:hover .brand__mark {
    transform: rotate(-12deg);
  }

  .site-nav {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.5rem clamp(0.7rem, 2vw, 1.4rem);
  }

  .site-nav__link {
    color: var(--text-muted);
    font-size: 0.95rem;
    font-weight: 500;
  }

  .site-nav__link:hover {
    color: var(--text);
    text-decoration: none;
  }

  .site-nav__link.is-active {
    color: var(--heading);
  }

  @media (max-width: 30rem) {
    .brand__text {
      display: none;
    }
  }
</style>
