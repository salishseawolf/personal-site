---
import "../styles/global.css";
import "../themes/helix-themes.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title,
  description = "Thomas G. Wolf — software, infrastructure, and AI engineering. Salish Sea Wolf LLC.",
} = Astro.props;

const siteName = "Salish Sea Wolf";
const pageTitle = title ? `${title} · ${siteName}` : siteName;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    {/* Per-page extras (e.g. a page-specific Google Fonts link) — most
    pages don't use this, keeping the base font stack system-only. */}
    <slot name="head" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#1c1e26" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#fdf0ed" media="(prefers-color-scheme: light)" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />

    <script defer src="https://umami.salishseawolf.com/recorder.js" data-website-id="fda489c5-ff79-4b92-bcdf-1f79a71cbc44" data-domains="salishseawolf.com,www.salishseawolf.com"></script>
    <script defer src="https://umami.salishseawolf.com/info.js" data-website-id="fda489c5-ff79-4b92-bcdf-1f79a71cbc44" data-domains="salishseawolf.com,www.salishseawolf.com"></script>

    {/* Set the Helix theme before first paint to avoid a flash. */}
    <script is:inline>
      (() => {
        try {
          var stored = localStorage.getItem("theme");
          if (stored) {
            document.documentElement.setAttribute("data-theme", stored);
          } else if (
            window.matchMedia &&
            window.matchMedia("(prefers-color-scheme: light)").matches
          ) {
            document.documentElement.setAttribute("data-theme", "github_light");
          }
        } catch (e) {
          /* no storage — CSS :root default (horizon-dark) applies */
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" class="page">
      <slot />
    </main>
    <Footer />

    <script>
      import { initCodeCopy } from "../lib/code-copy";
      initCodeCopy(document);
    </script>

    <style>
      .skip-link {
        position: absolute;
        left: 0.75rem;
        top: 0.75rem;
        transform: translateY(-150%);
        background: var(--heading);
        color: var(--bg);
        padding: 0.5rem 0.9rem;
        border-radius: var(--radius);
        font-weight: 600;
        transition: transform 0.15s ease;
        z-index: 20;
      }

      .skip-link:focus {
        transform: translateY(0);
      }
    </style>
  </body>
</html>
