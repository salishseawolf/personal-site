---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import BlogPostCard from "../components/BlogPostCard.astro";

const latestPosts = (await getCollection("blog"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const focus = [
  {
    k: "Software",
    d: "System architecture, Python, Rust, esoteric LISP, cross-platform tested and pushed through secure CI/CD Action workflows.",
  },
  {
    k: "AI",
    d: "Autonomous agents, agent sandboxing, RAG pipelines, and MCP tool integration wired into containerized job orchestration. Given great power but only under great control.",
  },
  {
    k: "Cloud & On-Prem",
    d: "Greenfield Kubernetes / K3s buildouts, Maintained as Infrastructure as Code, GitOps with Argo CD, and hybrid cloud + on-premise architecture on Hetzner/AWS/Azure and Proxmox.",
  },
  {
    k: "Security & Compliance",
    d: "NIST 800-171 and CMMC 2.0 programs, 1Password secret management, cluster hardening, private PKI with step-ca, and Authentik SSO with enforced MFA.",
  },
];

const elsewhere = [
  {
    href: "mailto:hire.me@wolfhouse.me",
    label: "Email",
    note: "hire.me@wolfhouse.me",
  },
  { href: "/resume/", label: "Resumé", note: "The full history" },
  {
    href: "https://github.com/salishseawolf",
    label: "GitHub",
    note: "Code and experiments",
  },
  {
    href: "https://www.linkedin.com/in/thomas-wolf-207773227/",
    label: "LinkedIn",
    note: "Professional network",
  },
  {
    href: "/tech-stack/",
    label: "Tech stack",
    note: "Tools, workflows, and what I build with",
  },
  { href: "/blog/", label: "Blog", note: "Posts and write-ups" },
];
---

<BaseLayout>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Inline&family=Monoton&display=swap"
    />
  </Fragment>

  <section class="section section--intro">
    <div class="wrap">
      <div class="bi-grid">
        <h2 class="bi-label">Who</h2>
        <div class="bi-content">
          <p class="eyebrow eyebrow--masthead">
            Thomas G. Wolf<br />Salish Sea Wolf LLC
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="bi-grid">
        <h2 class="bi-label">What</h2>
        <div class="bi-content">
          <div class="hero-copy">
            <h1 class="hero__title">
              <span class="hero__accent">Reliable</span> software and&nbsp;
              infrastructure for start-ups and large enterprises alike.
            </h1>
            <p class="hero__lede">
              I'm <strong>Thomas G. Wolf</strong>, a software and
              infrastructure architect in the Greater Seattle Area with 12+
              years shipping maintainable software, and standing up
              virtualization stacks in compliant environments from the ground
              up.
            </p>
            <div class="hero__actions">
              <a class="button button--primary" href="mailto:hire.me@wolfhouse.me">Get in touch</a>
              <a class="button" href="/resume/">View resumé</a>
              <a class="button" href="/tech-stack/">View tech stack</a>
            </div>
          </div>
          <ul class="cards">
            {
              focus.map((item) => (
                <li class="card">
                  <h3 class="card__title">{item.k}</h3>
                  <p class="card__body">{item.d}</p>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="bi-grid">
        <h2 class="bi-label">Where</h2>
        <div class="bi-content">
          <ul class="links">
            {
              elsewhere.map((link) => (
                <li>
                  <a class="link-row" href={link.href}>
                    <span class="link-row__label">{link.label}</span>
                    <span class="link-row__note">{link.note}</span>
                    <span class="link-row__arrow" aria-hidden="true">
                      &rarr;
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="bi-grid">
        <h2 class="bi-label">Blog</h2>
        <div class="bi-content">
          <ul class="post-previews">
            {latestPosts.map((post) => <li><BlogPostCard entry={post} /></li>)}
          </ul>
          <div class="blog-actions">
            <a class="button" href="/blog/">See more</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .section {
    padding-block: clamp(2rem, 6vw, 3.5rem);
  }

  .section + .section {
    border-top: 1px solid var(--border);
  }

  .section--intro {
    padding-block-start: clamp(3.5rem, 12vw, 7rem);
  }

  .eyebrow--masthead {
    font-family: "Big Shoulders Inline", var(--font-mono);
    font-size: 72px;
    margin-bottom: 1.5rem;
  }

  /* two-column layout: category label | content - same visual language as
     /tech-stack's three-column tri-grid (Monoton vertical label, sticky,
     flush against the header, opaque background so it stays readable over
     whatever scrolls underneath), just one fewer column and no per-row
     accordion machinery, since each section here is a single label next
     to a single block of content rather than a list of expandable rows. */
  .bi-grid {
    display: grid;
    grid-template-columns: 12% 1fr;
    column-gap: 1.5rem;
    align-items: start;
  }

  .bi-label {
    grid-column: 1;
    writing-mode: vertical-rl;
    text-orientation: upright;
    letter-spacing: -0.5em;
    position: sticky;
    top: calc(4rem + 1px);
    padding-top: 1.5rem;
    align-self: stretch;
    margin: 0;
    padding-right: 0.75rem;
    border-right: 1px solid var(--border);
    background: var(--bg);
    z-index: 1;
    font-family: "Monoton", system-ui, sans-serif;
    font-weight: 400;
    font-size: 72px;
    line-height: 1;
    color: var(--heading);
  }

  .bi-content {
    grid-column: 2;
    min-width: 0;
  }

  .hero-copy {
    max-width: 46rem;
    margin-bottom: 2.5rem;
  }

  @media (max-width: 48rem) {
    /* Same fix as /tech-stack's mobile fallback: dropping display: grid
       entirely (not just changing grid-template-columns) makes the
       explicit grid-column placements above inert instead of forcing the
       browser to implicitly regenerate the columns they name. */
    .bi-grid {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    .bi-label {
      writing-mode: horizontal-tb;
      text-orientation: mixed;
      letter-spacing: normal;
      font-size: 1.75rem;
      line-height: 1.2;
      padding-right: 0;
      padding-bottom: 0.5rem;
      border-right: none;
      border-bottom: 1px solid var(--border);
    }
  }

  .hero__title {
    font-size: clamp(2.1rem, 1.3rem + 3.6vw, 3.6rem);
    margin: 0.6em 0 0.5em;
  }

  .hero__accent {
    color: var(--accent);
  }

  .hero__lede {
    font-size: clamp(1.05rem, 1rem + 0.4vw, 1.25rem);
    color: var(--text-muted);
    margin: 0;
  }

  .hero__lede strong {
    color: var(--text);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 2rem;
  }

  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .card {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.4rem;
    background: var(--bg-raised);
    transition: border-color 0.15s ease, transform 0.15s ease;
  }

  .card:hover {
    border-color: var(--border-strong);
    transform: translateY(-2px);
  }

  .card__title {
    margin: 0 0 0.5rem;
    font-size: 1.05rem;
    color: var(--heading);
  }

  .card__body {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  @media (max-width: 40rem) {
    .cards {
      grid-template-columns: 1fr;
    }
  }

  .links {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border);
  }

  .link-row {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 1rem 0.25rem;
    border-bottom: 1px solid var(--border);
    color: var(--text);
  }

  .link-row:hover {
    text-decoration: none;
    padding-left: 0.75rem;
  }

  .link-row__label {
    font-weight: 600;
    min-width: 6rem;
  }

  .link-row:hover .link-row__label {
    color: var(--heading);
  }

  .link-row__note {
    color: var(--text-muted);
    font-size: 0.9rem;
    flex: 1;
  }

  .link-row__arrow {
    color: var(--accent);
    transition: transform 0.15s ease;
  }

  .link-row:hover .link-row__arrow {
    transform: translateX(4px);
  }

  .link-row,
  .link-row__label,
  .link-row:hover {
    transition: padding 0.15s ease, color 0.15s ease;
  }

  .post-previews {
    list-style: none;
    margin: 0 0 1.5rem;
    padding: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  @media (max-width: 60rem) {
    .post-previews {
      grid-template-columns: 1fr;
    }
  }

  .blog-actions {
    display: flex;
  }
</style>
